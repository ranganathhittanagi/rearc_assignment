<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" agent="devin-cli" version="24.0.0">
  <diagram id="rearc-architecture" name="Rearc Architecture">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="Rearc Data Pipeline Architecture" style="text;html=1;fontSize=22;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="1600" height="30" as="geometry" />
        </mxCell>

        <!-- Sources -->
        <mxCell id="src_website" value="Source: BLS Website&#10;download.bls.gov/pub/time.series/pr/&#10;(directory of .Current / .Alldata / dimension files)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="220" height="90" as="geometry" />
        </mxCell>

        <mxCell id="src_api" value="Source: DataUSA API&#10;honolulu-api.datausa.io&#10;(acs_yg_total_population_1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="260" width="220" height="90" as="geometry" />
        </mxCell>

        <!-- Ingestion Job -->
        <mxCell id="ingestion_job" value="Databricks Job: rearc_ingestion_job&#10;(spark_python_task: ingest_sources)&#10;src/rearc_pipeline/ingestion/job.py&#10;- website_ingestion() (BLS files)&#10;- api_ingestion() (population.json)&#10;Scheduled daily 06:00 UTC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=center;" vertex="1" parent="1">
          <mxGeometry x="320" y="150" width="260" height="140" as="geometry" />
        </mxCell>

        <!-- Volume -->
        <mxCell id="volume" value="Unity Catalog Volume&#10;/Volumes/workspace/default/rearc_raw&#10;&#10;pr/ (BLS raw files)&#10;population.json" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=center;" vertex="1" parent="1">
          <mxGeometry x="640" y="160" width="220" height="120" as="geometry" />
        </mxCell>

        <!-- Medallion container -->
        <mxCell id="medallion" value="Lakeflow Declarative Pipeline: rearc_medallion_pipeline (Databricks DLT)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontSize=14;fillColor=#f5f5f5;strokeColor=#666666;align=center;" vertex="1" parent="1">
          <mxGeometry x="920" y="60" width="620" height="700" as="geometry" />
        </mxCell>

        <!-- Bronze -->
        <mxCell id="bronze" value="BRONZE (bronze.py)&#10;Auto Loader, raw / string, incremental&#10;&#10;- pr_data_0_current&#10;- pr_data_1_alldata&#10;- pr_series&#10;- pr_class, pr_contacts, pr_duration&#10;- pr_footnote, pr_measure, pr_period&#10;- pr_seasonal, pr_sector, pr_txt&#10;- population_raw (DataUSA API, nested)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="950" y="110" width="560" height="150" as="geometry" />
        </mxCell>

        <!-- Silver -->
        <mxCell id="silver" value="SILVER (silver.py)&#10;Cleaned, typed, trimmed, DQ expectations&#10;&#10;- pr_data_current / pr_data_alldata (typed, expect_all_or_drop)&#10;- pr_series (dimension, all cols retained)&#10;- population (flattened per-year from JSON)&#10;- pr_class, pr_contacts, pr_duration, pr_footnote,&#10;  pr_measure, pr_period, pr_seasonal, pr_sector, pr_txt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="950" y="330" width="560" height="150" as="geometry" />
        </mxCell>

        <!-- Gold -->
        <mxCell id="gold" value="GOLD (gold.py)&#10;Business-ready aggregates for analytics&#10;&#10;- population_stats&#10;  (mean/stddev of population, 2013-2018)&#10;- pr_data_best_year&#10;  (best year per BLS series, joined with dims)&#10;- PRS30006032_Q01_yearly_population&#10;  (series Q01 values joined with yearly population)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="950" y="560" width="560" height="150" as="geometry" />
        </mxCell>

        <!-- Dashboard -->
        <mxCell id="dashboard" value="Dashboard&#10;(Databricks SQL Dashboard / BI tool)&#10;built on workspace.gold.* tables" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0e0e3;strokeColor=#76a5af;align=center;" vertex="1" parent="1">
          <mxGeometry x="1620" y="595" width="220" height="80" as="geometry" />
        </mxCell>

        <!-- Edges -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="src_website" target="ingestion_job">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="src_api" target="ingestion_job">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="ingestion_job" target="volume">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="Auto Loader (cloudFiles)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="volume" target="bronze">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="bronze" target="silver">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="silver" target="gold">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="gold" target="dashboard">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
